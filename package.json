{
  "name": "@familyflix/source",
  "productName": "FamilyFlix",
  "version": "0.1.0",
  "private": true,
  "description": "A Netflix for the family movie folder — a local, searchable movie library and player.",
  "license": "MIT",
  "author": "Carlos Rezai",
  "repository": "github:carlos-rezai/FamilyFlix",
  "main": "electron/dist/main.js",
  "scripts": {
    "dev": "concurrently --names \"server,web\" --prefix-colors \"cyan,magenta\" --kill-others \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch server/src/main.ts",
    "dev:web": "nx serve",
    "electron:dev": "node node_modules/concurrently/dist/bin/index.js --names \"web,shell\" --prefix-colors \"magenta,yellow\" --kill-others \"npm:dev:web\" \"node electron/scripts/buildElectron.mjs --watch\"",
    "electron:start": "node node_modules/nx/dist/bin/nx.js build && node electron/scripts/buildElectron.mjs --start",
    "electron:native": "node electron/scripts/fetchNative.mjs",
    "electron:ffmpeg": "node electron/scripts/fetchFfmpeg.mjs",
    "electron:icon": "node electron/scripts/buildIcon.mjs",
    "electron:package": "node electron/scripts/packageApp.mjs",
    "start": "nx serve",
    "build": "nx build",
    "test": "nx test",
    "typecheck": "tsc -b tsconfig.json",
    "db:seed-series": "tsx server/src/db/seriesSeed/seriesSeed.ts",
    "prepare": "husky"
  },
  "nx": {
    "includedScripts": []
  },
  "dependencies": {},
  "devDependencies": {
    "@eslint/js": "^9.8.0",
    "@fontsource/hanken-grotesk": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/source-serif-4": "^5.3.0",
    "@nx/eslint": "23.0.1",
    "@nx/eslint-plugin": "23.0.1",
    "@nx/vite": "23.0.1",
    "@nx/vitest": "23.0.1",
    "@testing-library/dom": "10.4.0",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "^14.6.6",
    "@types/better-sqlite3": "^7.6.13",
    "@types/busboy": "^1.5.4",
    "@types/express": "^5.0.6",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "@vitest/coverage-v8": "~4.1.0",
    "better-sqlite3": "^12.4.1",
    "busboy": "^1.6.0",
    "concurrently": "^10.0.4",
    "electron": "^38.8.6",
    "electron-builder": "^26.15.3",
    "electron-updater": "^6.8.9",
    "esbuild": "^0.28.1",
    "eslint": "^9.8.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-import": "2.31.0",
    "eslint-plugin-jsx-a11y": "6.10.1",
    "eslint-plugin-react": "7.35.0",
    "eslint-plugin-react-hooks": "5.0.0",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "husky": "^9.1.7",
    "jsdom": "^27.1.0",
    "lint-staged": "^16.4.0",
    "nx": "23.0.1",
    "prettier": "^3.8.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "6.30.3",
    "sharp": "^0.35.5",
    "styled-components": "^6.4.3",
    "tslib": "^2.3.0",
    "tsx": "^4.23.9",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.40.0",
    "vite": "^8.0.0",
    "vitest": "~4.1.0"
  }
}
