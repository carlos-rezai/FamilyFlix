{
  "name": "@familyflix/source",
  "version": "0.0.0",
  "private": true,
  "description": "A Netflix for the family movie folder — a local, searchable movie library and player.",
  "license": "MIT",
  "scripts": {
    "dev": "concurrently --names \"server,web\" --prefix-colors \"cyan,magenta\" --kill-others \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch server/src/main.ts",
    "dev:web": "nx serve",
    "db:seed": "tsx server/src/db/seed/seed.ts",
    "start": "nx serve",
    "build": "nx build",
    "test": "nx test",
    "typecheck": "tsc -b tsconfig.json",
    "prepare": "husky"
  },
  "nx": {
    "includedScripts": []
  },
  "dependencies": {
    "better-sqlite3": "^12.4.1",
    "express": "^5.2.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "6.30.3",
    "styled-components": "^6.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.8.0",
    "@nx/eslint": "23.0.1",
    "@nx/eslint-plugin": "23.0.1",
    "@nx/vite": "23.0.1",
    "@nx/vitest": "23.0.1",
    "@testing-library/dom": "10.4.0",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "^14.6.6",
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.6",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "@vitest/coverage-v8": "~4.1.0",
    "concurrently": "^10.0.4",
    "eslint": "^9.8.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-import": "2.31.0",
    "eslint-plugin-jsx-a11y": "6.10.1",
    "eslint-plugin-react": "7.35.0",
    "eslint-plugin-react-hooks": "5.0.0",
    "husky": "^9.1.7",
    "jsdom": "^27.1.0",
    "lint-staged": "^16.4.0",
    "nx": "23.0.1",
    "prettier": "^3.8.4",
    "tslib": "^2.3.0",
    "tsx": "^4.23.9",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.40.0",
    "vite": "^8.0.0",
    "vitest": "~4.1.0"
  }
}
