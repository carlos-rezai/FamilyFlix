{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "types": ["node", "electron"]
  },
  // The Desktop shell's shipping code (issue #216), and the shared Shell
  // handshake and Software update types it imports (issue #236). The tests
  // belong to `tsconfig.spec.json`, the way the frontend's and the backend's
  // do, so a RED `test:` commit can still ask whether the shell itself
  // compiles. `test-support/` is excluded so
  // shipping code cannot import a double (issue #226).
  "include": [
    "electron/**/*.ts",
    "src/types/shell.ts",
    "src/types/update.ts",
    "src/types/familyflix.d.ts"
  ],
  "exclude": [
    "electron/.native/**/*",
    "electron/dist/**/*",
    "electron/test-support/**/*",
    "electron/**/*.spec.ts",
    "electron/**/*.test.ts"
  ]
}
