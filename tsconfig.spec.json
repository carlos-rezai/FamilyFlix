{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist/out-tsc",
    // The tests spread a sent `FormData` to read its parts in order, which is
    // the iterable half of the DOM's types.
    "lib": ["es2020", "dom", "dom.iterable"],
    // `vite.config.mts` is type-checked here, and Vite ships its types behind an
    // exports map that `node` resolution can't read. Resolve like the bundler
    // that actually consumes this project.
    "moduleResolution": "bundler",
    "types": [
      "vitest/globals",
      "vitest/importMeta",
      "vite/client",
      "node",
      "vitest"
    ]
  },
  "include": [
    "src/test-support/**/*",
    "server/src/test-support/**/*",
    "electron/test-support/**/*",
    "server/**/*.test.ts",
    "server/**/*.spec.ts",
    "vite.config.ts",
    "vite.config.mts",
    "vitest.config.ts",
    "vitest.config.mts",
    "src/**/*.test.ts",
    "src/**/*.spec.ts",
    "src/**/*.test.tsx",
    "src/**/*.spec.tsx",
    "src/**/*.test.js",
    "src/**/*.spec.js",
    "src/**/*.test.jsx",
    "src/**/*.spec.jsx",
    "src/**/*.d.ts",
    ".husky/**/*.ts",
    "electron/**/*.test.ts",
    "electron/**/*.spec.ts"
  ]
}
